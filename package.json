{
  "name": "observaquiz-contracts",
  "version": "1.0.0",
  "description": "Shared contracts and coordination for ObservaQuiz project",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:local": "jest --config jest.local.config.js",
    "test:staging": "jest --config jest.staging.config.js",
    "validate:openapi": "swagger-codegen validate -i api-contracts/quiz-api.yaml",
    "generate:types": "npm run generate:ts && npm run generate:go",
    "generate:ts": "openapi-typescript api-contracts/quiz-api.yaml --output types/generated.ts",
    "generate:go": "oapi-codegen -package types -generate types api-contracts/quiz-api.yaml > types/generated.go",
    "lint": "eslint integration-tests/**/*.js",
    "format": "prettier --write .",
    "precommit": "npm run validate:openapi && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeycombio/observaquiz-contracts.git"
  },
  "keywords": [
    "observability",
    "contracts",
    "api",
    "testing",
    "opentelemetry"
  ],
  "author": "ObservaQuiz Team",
  "license": "ISC",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "axios": "^1.6.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "openapi-typescript": "^6.7.0",
    "prettier": "^3.1.0",
    "swagger-codegen": "^3.0.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "yaml": "^2.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/integration-tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/integration-tests/setup.js"
    ]
  }
}
